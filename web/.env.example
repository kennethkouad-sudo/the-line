# Settings for running the app on your own computer. Copy to .env.local and adjust.
# On Clever Cloud these are set in the app's "Environment variables" page instead.
# Never commit real values.

# Postgres (docker compose up db). On Clever Cloud the Postgres add-on provides POSTGRESQL_ADDON_URI.
DATABASE_URL=postgres://the_line:local-dev-only@localhost:5432/the_line

# Raw audio storage. Locally, a folder (still encrypted). On Clever Cloud: the Cellar add-on
# (CELLAR_ADDON_HOST, CELLAR_ADDON_KEY_ID, CELLAR_ADDON_KEY_SECRET) plus S3_BUCKET.
STORAGE_DIR=.storage/dev

# Secrets. Make real ones with: openssl rand -base64 32
MASTER_KEY=ZGV2LW9ubHktbWFzdGVyLWtleS0zMi1ieXRlcy0hISE=
TOKEN_SALT=dev-only-token-salt
RATE_LIMIT_SECRET=dev-only-rate-limit-secret

# Cloudflare Turnstile. These are Cloudflare's public test keys: they always pass.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# Staging only: APP_ENV=staging, plus the password visitors must enter.
# APP_ENV=staging
# STAGING_USER=
# STAGING_PASSWORD=

# The address deletion links start with. Defaults to the address the request came in on.
# PUBLIC_BASE_URL=https://line.histrnger.com
